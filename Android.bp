package {
    default_applicable_licenses: ["android_vcam_license"],
}

license {
    name: "android_vcam_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

cc_library_headers {
    name: "libvcam_headers",
    vendor_available: true,
    export_include_dirs: ["hal/include"],
}

cc_library_static {
    name: "libvcam_camera_service_router_mode",
    host_supported: true,
    srcs: ["runtime/CameraServiceRouterMode.cpp"],
    local_include_dirs: ["runtime/include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}

cc_library_static {
    name: "libvcam_cameraserver_bootstrap_mode",
    host_supported: true,
    srcs: ["runtime/CameraServerBootstrapMode.cpp"],
    local_include_dirs: ["runtime/include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}

cc_test {
    name: "vcam_camera_service_router_mode_test",
    host_supported: true,
    srcs: ["tests/camera_service_router_mode_test.cpp"],
    local_include_dirs: ["runtime/include"],
    static_libs: ["libvcam_camera_service_router_mode"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-UNDEBUG",
    ],
    cpp_std: "c++17",
}

cc_test {
    name: "vcam_cameraserver_bootstrap_mode_test",
    host_supported: true,
    srcs: ["tests/cameraserver_bootstrap_mode_test.cpp"],
    local_include_dirs: ["runtime/include"],
    static_libs: ["libvcam_cameraserver_bootstrap_mode"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-UNDEBUG",
    ],
    cpp_std: "c++17",
}

cc_binary {
    name: "vcam_cameraserver_launcher",
    compile_multilib: "64",
    srcs: ["runtime/platform/CameraServerLauncher.cpp"],
    local_include_dirs: ["runtime/include"],
    static_libs: ["libvcam_cameraserver_bootstrap_mode"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}

cc_library_shared {
    name: "libvcam_cameraserver_router",
    compile_multilib: "64",
    srcs: ["runtime/platform/AndroidCameraServiceRouter.cpp"],
    local_include_dirs: ["runtime/include"],
    static_libs: ["libvcam_camera_service_router_mode"],
    shared_libs: [
        "libbinder",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fvisibility=hidden",
    ],
    version_script: "runtime/camera_service_router.exports",
    cpp_std: "c++17",
}

cc_library_static {
    name: "libvcam_frame_core",
    vendor_available: true,
    srcs: [
        "hal/src/FrameRenderer.cpp",
        "hal/src/PatternGenerator.cpp",
        "hal/src/RgbFrame.cpp",
    ],
    export_include_dirs: ["hal/include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}

cc_library_static {
    name: "libvcam_route_core",
    vendor_available: true,
    srcs: [
        "hal/src/RouteResolver.cpp",
        "hal/src/ScopedCameraRouter.cpp",
    ],
    export_include_dirs: ["hal/include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}

