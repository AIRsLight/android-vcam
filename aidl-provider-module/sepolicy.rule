allow ksu hal_camera_service service_manager { add find }
# Keep persistent routes and provider frames independent from OEM-specific
# /data/vendor/camera labels. Some AOSP products do not define
# vendor_camera_data_file at all.
type vcam_camera_data_file file_type
typeattribute vcam_camera_data_file data_file_type
allow ksu vcam_camera_data_file dir { add_name create getattr open read remove_name search setattr write }
allow ksu vcam_camera_data_file file { create getattr map open read rename setattr unlink write }
allow hal_camera_default vcam_camera_data_file dir { getattr open read search }
allow hal_camera_default vcam_camera_data_file file { getattr map open read }
# A systemless secondary instance has no matching service_contexts entry when
# servicemanager starts, so it is registered as default_android_service.  The
# exact vcam/0 mapping belongs in product policy for a built-in integration;
# this one-shot module must grant the minimum lookup path dynamically.
allow ksu default_android_service service_manager { add find }
allow cameraserver default_android_service service_manager find
allow ksu servicemanager binder { call transfer }
allow servicemanager ksu binder { call transfer }
allow cameraserver ksu binder { call transfer }
allow ksu cameraserver binder { call transfer }
# The root-free manager can connect only to vcamd's fixed, UID-authenticated
# abstract socket. The daemon and provider runners remain owned by KernelSU.
allow untrusted_app ksu unix_stream_socket connectto
