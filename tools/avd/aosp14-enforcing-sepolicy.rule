# AVD-only live rules. Production ROM integration uses the exact service
# context and compiled policy in aosp/provider/sepolicy instead.
type vcam_camera_data_file file_type
typeattribute vcam_camera_data_file data_file_type
allow hal_camera_default default_android_service service_manager { add find }
allow cameraserver default_android_service service_manager find
allow cameraserver cameraserver_tmpfs dir { search read write add_name remove_name getattr }
allow cameraserver cameraserver_tmpfs file { create open read write getattr unlink }
allow cameraserver vcam_camera_data_file dir { search read open getattr }
allow cameraserver vcam_camera_data_file file { open read getattr }
allow hal_camera_default vcam_camera_data_file dir { search read open getattr }
allow hal_camera_default vcam_camera_data_file file { open read getattr map }
