package {
    default_applicable_licenses: ["android_vcam_license"],
}

cc_library_shared {
    name: "libvcam_googlecamerahwl_impl",
    vendor: true,
    defaults: [
        "//hardware/google/camera/devices/EmulatedCamera/hwl:libgooglecamerahwl_impl_defaults",
    ],
    srcs: ["VcamCameraProviderHwl.cpp"],
    cflags: ["-DANDROID_VCAM_CUSTOM_FACTORY"],
    include_dirs: [
        "hardware/google/camera/devices/EmulatedCamera/hwl",
    ],
    header_libs: ["libvcam_headers"],
    static_libs: [
        "libvcam_frame_core",
        "libvcam_route_core",
    ],
}

cc_binary {
    name: "android.hardware.camera.provider-service-vcam",
    defaults: [
        "//hardware/google/camera/common/hal/aidl_service:camera_service_vcam_defaults",
        "//hardware/google/camera/common/hal/aidl_service:camera_service_eager_hal_defaults",
    ],
    required: [
        "libvcam_googlecamerahwl_impl",
        "emu_camera_back.json",
        "emu_camera_front.json",
        "emu_camera_depth.json",
    ],
    init_rc: ["android.hardware.camera.provider-service-vcam.rc"],
    vintf_fragments: ["android.hardware.camera.provider-service-vcam.xml"],
}

// Android 14 promotes the camera provider interface to stable AIDL v2. Keep a
// distinct installed filename so Soong can parse the v1 and v2 definitions in
// the same namespace without generating two rules for one output path.
cc_binary {
    name: "android.hardware.camera.provider-service-vcam-v2",
    defaults: [
        "//hardware/google/camera/common/hal/aidl_service:camera_service_vcam_defaults",
        "//hardware/google/camera/common/hal/aidl_service:camera_service_eager_hal_defaults",
    ],
    required: [
        "libvcam_googlecamerahwl_impl",
        "emu_camera_back.json",
        "emu_camera_front.json",
        "emu_camera_depth.json",
    ],
    init_rc: ["android-14/android.hardware.camera.provider-service-vcam-v2.rc"],
    vintf_fragments: ["android-14/android.hardware.camera.provider-service-vcam-v2.xml"],
}
