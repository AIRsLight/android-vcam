service vendor.vcam-provider-2-4 /vendor/bin/hw/android.hardware.camera.provider@2.4-vcam-service
    interface android.hardware.camera.provider@2.4::ICameraProvider vcam/0
    class hal
    user cameraserver
    group audio camera input drmrpc
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance
