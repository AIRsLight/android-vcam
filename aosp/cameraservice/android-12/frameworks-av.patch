+Status CameraService::resolveScopedCameraId(const String8& requestedCameraId,
+        const String16& clientPackageName, String8* selectedCameraId) const {
+    if (selectedCameraId == nullptr) {
+        return STATUS_ERROR(ERROR_ILLEGAL_ARGUMENT, "selectedCameraId is NULL");
+    }
+    if (vcam::ScopedCameraRouter::isInternalCameraId(requestedCameraId.string())) {
+        return STATUS_ERROR_FMT(ERROR_ILLEGAL_ARGUMENT,
+                "Camera ID \"%s\" is not publicly accessible", requestedCameraId.string());
+    }
+
+    *selectedCameraId = requestedCameraId;
+    const String8 packageName(clientPackageName);
+    const auto scopedRoute = vcam::ScopedCameraRouter::resolve(
+            packageName.string(), requestedCameraId.string());
+    if (scopedRoute.configured && !scopedRoute.available) {
+        ALOGE("VCAM route unavailable; failing closed package=%s camera=%s provider=%s",
+                packageName.string(), requestedCameraId.string(),
+                scopedRoute.providerId.c_str());
+        return STATUS_ERROR_FMT(ERROR_DISCONNECTED,
+                "Configured virtual camera provider \"%s\" is unavailable",
+                scopedRoute.providerId.c_str());
+    }
+    if (!scopedRoute.redirected) return Status::ok();
+
+    const String8 candidate(scopedRoute.effectiveCameraId.c_str());
+    const auto candidateState = getCameraState(candidate);
+    if (candidateState == nullptr ||
+            candidateState->getStatus() == StatusInternal::NOT_PRESENT ||
+            candidateState->getStatus() == StatusInternal::ENUMERATING) {
+        ALOGE("VCAM route unavailable; failing closed package=%s camera=%s provider=%s "
+                "internal=%s", packageName.string(), requestedCameraId.string(),
+                scopedRoute.providerId.c_str(), candidate.string());
+        return STATUS_ERROR_FMT(ERROR_DISCONNECTED,
+                "Configured virtual camera provider \"%s\" is unavailable",
+                scopedRoute.providerId.c_str());
+    }
+
+    *selectedCameraId = candidate;
+    ALOGI("VCAM scoped route package=%s camera=%s provider=%s internal=%s",
+            packageName.string(), requestedCameraId.string(),
+            scopedRoute.providerId.c_str(), selectedCameraId->string());
+    return Status::ok();
+}
