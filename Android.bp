package {
    default_applicable_licenses: ["android_vcam_license"],
}

license {
    name: "android_vcam_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

cc_library_headers {
    name: "libvcam_headers",
    vendor_available: true,
    export_include_dirs: ["hal/include"],
}

cc_library_static {
    name: "libvcam_frame_core",
    vendor_available: true,
    srcs: [
        "hal/src/FrameRenderer.cpp",
        "hal/src/PatternGenerator.cpp",
        "hal/src/RgbFrame.cpp",
    ],
    export_include_dirs: ["hal/include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}

cc_library_static {
    name: "libvcam_route_core",
    vendor_available: true,
    srcs: [
        "hal/src/RouteResolver.cpp",
        "hal/src/ScopedCameraRouter.cpp",
    ],
    export_include_dirs: ["hal/include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}
