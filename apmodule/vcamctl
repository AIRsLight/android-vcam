#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR="/data/adb/android_vcam"
PROVIDER_STATE_DIR="$STATE_DIR/providers"
FRAME_DIR="/data/vendor/camera/vcam"
PROVIDER_FRAME_DIR="$FRAME_DIR/providers"
ROUTES_FILE="$FRAME_DIR/routes.tsv"
PROFILE_FILE="$STATE_DIR/device-profile.conf"

find_publisher() {
    for candidate in \
        "$MODDIR/vendor/bin/vcam-publisher" \
        "$MODDIR/system/vendor/bin/vcam-publisher"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

find_runner() {
    [ -x "$MODDIR/provider-runner.sh" ] && {
        echo "$MODDIR/provider-runner.sh"
        return 0
    }
    return 1
}

find_streamer() {
    for candidate in \
        "$MODDIR/system/bin/vcam-streamer" \
        "$MODDIR/system/system/bin/vcam-streamer" \
        "$MODDIR/vendor/bin/vcam-streamer" \
        "$MODDIR/system/vendor/bin/vcam-streamer"; do
        [ -x "$candidate" ] && {
            echo "$candidate"
            return 0
        }
    done
    return 1
}

prepare_dirs() {
    mkdir -p "$STATE_DIR" "$PROVIDER_STATE_DIR" "$FRAME_DIR" \
        "$PROVIDER_FRAME_DIR" || return 1
    chmod 0700 "$STATE_DIR" "$PROVIDER_STATE_DIR"
    chown camera:camera "$FRAME_DIR" "$PROVIDER_FRAME_DIR"
    chmod 0770 "$FRAME_DIR" "$PROVIDER_FRAME_DIR"
    touch "$ROUTES_FILE"
    chown camera:camera "$ROUTES_FILE"
    chmod 0640 "$ROUTES_FILE"
    restorecon "$FRAME_DIR" "$ROUTES_FILE" >/dev/null 2>&1
    # Provider contents are labeled when created/published. Avoid recursively
    # relabeling cached media on every read-only list/status request.
    restorecon "$PROVIDER_FRAME_DIR" >/dev/null 2>&1
}

valid_id() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#1}" -le 64 ]
}

valid_package() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#1}" -le 255 ]
}

valid_base64() {
    case "$1" in
        *[!A-Za-z0-9+/=]*) return 1 ;;
    esac
    return 0
}

provider_exists() {
    case "$1" in
        physical-0|physical-1) return 0 ;;
    esac
    valid_id "$1" && [ -f "$PROVIDER_STATE_DIR/$1/meta" ] && \
        [ -d "$PROVIDER_FRAME_DIR/$1" ]
}

meta_value() {
    key="$1"
    file="$2"
    sed -n "s/^${key}=//p" "$file" | head -n 1
}

config_value() {
    value=$(meta_value "$1" "$2")
    [ -n "$value" ] && printf '%s\n' "$value" || printf '%s\n' "$3"
}

valid_number_between() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

valid_source_config() {
    fps="$1"
    width="$2"
    height="$3"
    valid_number_between "$fps" 1 60 &&
        valid_number_between "$width" 160 4096 &&
        valid_number_between "$height" 120 4096 || return 1
    pixels=$((width * height))
    pixel_rate=$((pixels * fps))
    [ "$pixels" -le 12582912 ] && [ "$pixel_rate" -le 124416000 ]
}

valid_view() {
    old_ifs=$IFS
    IFS=,
    set -- $1
    IFS=$old_ifs
    [ "$#" -eq 4 ] || return 1
    case "$1" in 0|90|180|270) ;; *) return 1 ;; esac
    valid_number_between "$2" 100 8000 &&
        valid_number_between "$3" 0 1000 &&
        valid_number_between "$4" 0 1000
}

write_runtime_config() {
    id="$1"
    meta="$PROVIDER_STATE_DIR/$id/meta"
    fps=$(config_value fps "$meta" 15)
    max_width=$(config_value max_width "$meta" 1280)
    max_height=$(config_value max_height "$meta" 720)
    view0=$(config_value view0 "$meta" '0,1000,500,500')
    view1=$(config_value view1 "$meta" '0,1000,500,500')
    runtime="$PROVIDER_FRAME_DIR/$id"
    printf '%s,%s,%s\n' "$fps" "$max_width" "$max_height" > "$runtime/source.cfg"
    printf '%s\n' "$view0" > "$runtime/view-0.cfg"
    printf '%s\n' "$view1" > "$runtime/view-1.cfg"
    chown camera:camera "$runtime/source.cfg" "$runtime/view-0.cfg" "$runtime/view-1.cfg"
    chmod 0640 "$runtime/source.cfg" "$runtime/view-0.cfg" "$runtime/view-1.cfg"
    restorecon "$runtime/source.cfg" "$runtime/view-0.cfg" "$runtime/view-1.cfg" >/dev/null 2>&1
}

print_provider() {
    id="$1"
    type="$2"
    name="$3"
    source="$4"
    removable="$5"
    running="$6"
    meta="$7"
    fps=$(config_value fps "$meta" 15)
    max_width=$(config_value max_width "$meta" 1280)
    max_height=$(config_value max_height "$meta" 720)
    view0=$(config_value view0 "$meta" '0,1000,500,500')
    view1=$(config_value view1 "$meta" '0,1000,500,500')
    printf 'PROVIDER\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$id" "$type" "$name" "$source" "$removable" "$running" \
        "$fps" "$max_width" "$max_height" "$view0" "$view1"
}

list_providers() {
    prepare_dirs || return 1
    print_provider physical-0 physical \
        "$(printf 'Physical camera 0' | base64 | tr -d '\n')" '' false true /dev/null
    print_provider physical-1 physical \
        "$(printf 'Physical camera 1' | base64 | tr -d '\n')" '' false true /dev/null
    for directory in "$PROVIDER_STATE_DIR"/*; do
        [ -d "$directory" ] || continue
        meta="$directory/meta"
        [ -f "$meta" ] || continue
        id=${directory##*/}
        type=$(meta_value type "$meta")
        name=$(meta_value name_b64 "$meta")
        source=$(meta_value source_b64 "$meta")
        if [ ! -e "$PROVIDER_FRAME_DIR/$id/enabled" ]; then
            running=false
        elif [ -f "$directory/stream.pid" ] && \
            kill -0 "$(cat "$directory/stream.pid" 2>/dev/null)" 2>/dev/null; then
            running=true
        elif [ "$type" = pattern ] || \
            { [ "$type" = image ] && [ -f "$PROVIDER_FRAME_DIR/$id/frame.rgb" ]; }; then
            running=true
        else
            running=false
        fi
        print_provider "$id" "$type" "$name" "$source" true "$running" "$meta"
    done
}

add_provider() {
    id="$1"
    type="$2"
    name_b64="$3"
    source_b64="$4"
    valid_id "$id" || { echo "invalid provider id" >&2; return 2; }
    case "$id" in physical-0|physical-1) echo "reserved provider id" >&2; return 2 ;; esac
    case "$type" in pattern|image|video|http|https|hls|rtsp) ;;
        *) echo "unsupported provider type" >&2; return 2 ;;
    esac
    valid_base64 "$name_b64" && valid_base64 "$source_b64" || {
        echo "invalid provider encoding" >&2
        return 2
    }
    prepare_dirs || return 3
    [ ! -e "$PROVIDER_STATE_DIR/$id" ] || {
        echo "provider already exists" >&2
        return 4
    }
    mkdir -p "$PROVIDER_STATE_DIR/$id" "$PROVIDER_FRAME_DIR/$id" || return 3
    {
        printf 'type=%s\n' "$type"
        printf 'name_b64=%s\n' "$name_b64"
        printf 'source_b64=%s\n' "$source_b64"
        printf 'fps=15\nmax_width=1280\nmax_height=720\n'
        printf 'view0=0,1000,500,500\nview1=0,1000,500,500\n'
    } > "$PROVIDER_STATE_DIR/$id/meta"
    chown -R camera:camera "$PROVIDER_FRAME_DIR/$id"
    chmod 0750 "$PROVIDER_FRAME_DIR/$id"
    restorecon -RF "$PROVIDER_FRAME_DIR/$id" >/dev/null 2>&1
    write_runtime_config "$id"
    echo "added"
}

provider_config() {
    id="$1"
    valid_id "$id" && provider_exists "$id" || { echo "provider not found" >&2; return 2; }
    case "$id" in physical-0|physical-1) echo "physical provider is read-only" >&2; return 3 ;; esac
    meta="$PROVIDER_STATE_DIR/$id/meta"
    printf 'CONFIG\t%s\t%s\t%s\t%s\t%s\n' \
        "$(config_value fps "$meta" 15)" \
        "$(config_value max_width "$meta" 1280)" \
        "$(config_value max_height "$meta" 720)" \
        "$(config_value view0 "$meta" '0,1000,500,500')" \
        "$(config_value view1 "$meta" '0,1000,500,500')"
}

provider_config_set() {
    id="$1"; fps="$2"; max_width="$3"; max_height="$4"; view0="$5"; view1="$6"
    valid_id "$id" && provider_exists "$id" || { echo "provider not found" >&2; return 2; }
    case "$id" in physical-0|physical-1) return 3 ;; esac
    valid_source_config "$fps" "$max_width" "$max_height" &&
        valid_view "$view0" && valid_view "$view1" || {
            echo "invalid provider configuration" >&2
            return 2
        }
    meta="$PROVIDER_STATE_DIR/$id/meta"
    temporary="$meta.new"
    awk '!/^(fps|max_width|max_height|view0|view1)=/' "$meta" > "$temporary" || return 4
    {
        printf 'fps=%s\nmax_width=%s\nmax_height=%s\n' "$fps" "$max_width" "$max_height"
        printf 'view0=%s\nview1=%s\n' "$view0" "$view1"
    } >> "$temporary"
    mv -f "$temporary" "$meta" || return 4
    chmod 0600 "$meta"
    write_runtime_config "$id" || return 4
    echo "configured"
}

provider_update() {
    id="$1"; name_b64="$2"; source_b64="$3"; fps="$4"
    max_width="$5"; max_height="$6"; view0="$7"; view1="$8"
    valid_id "$id" && provider_exists "$id" || { echo "provider not found" >&2; return 2; }
    case "$id" in physical-0|physical-1) echo "physical provider is read-only" >&2; return 3 ;; esac
    valid_base64 "$name_b64" && valid_base64 "$source_b64" &&
        valid_source_config "$fps" "$max_width" "$max_height" &&
        valid_view "$view0" && valid_view "$view1" || {
            echo "invalid provider update" >&2
            return 2
        }
    meta="$PROVIDER_STATE_DIR/$id/meta"
    type=$(meta_value type "$meta")
    source=$(printf '%s' "$source_b64" | base64 -d 2>/dev/null) || return 2
    case "$type:$source" in
        pattern:|image:|video:*) ;;
        https:https://*|http:http://*|hls:http://*|rtsp:rtsp://*) ;;
        *) echo "source URL does not match provider type" >&2; return 2 ;;
    esac
    backup="$meta.backup-$$"
    temporary="$meta.new-$$"
    cp "$meta" "$backup" || return 4
    was_enabled=false
    if [ -e "$PROVIDER_FRAME_DIR/$id/enabled" ] || \
       [ -e "$PROVIDER_STATE_DIR/$id/autostart" ]; then
        was_enabled=true
    fi
    awk '!/^(name_b64|source_b64|fps|max_width|max_height|view0|view1)=/' \
        "$meta" > "$temporary" || { rm -f "$backup" "$temporary"; return 4; }
    {
        printf 'name_b64=%s\nsource_b64=%s\n' "$name_b64" "$source_b64"
        printf 'fps=%s\nmax_width=%s\nmax_height=%s\n' "$fps" "$max_width" "$max_height"
        printf 'view0=%s\nview1=%s\n' "$view0" "$view1"
    } >> "$temporary"
    mv -f "$temporary" "$meta" || { rm -f "$backup"; return 4; }
    chmod 0600 "$meta"
    write_runtime_config "$id" || { cp "$backup" "$meta"; rm -f "$backup"; return 4; }
    case "$type" in pattern|image) ;;
        *)
            if [ "$was_enabled" = true ]; then
                stop_provider "$id"
                start_error=$(start_provider 2>&1)
                if [ "$?" -ne 0 ]; then
                    cp "$backup" "$meta"
                    chmod 0600 "$meta"
                    write_runtime_config "$id" >/dev/null 2>&1
                    start_provider "$id" >/dev/null 2>&1
                    rm -f "$backup"
                    echo "provider update failed: $start_error" >&2
                    return 6
                fi
            fi
            ;;
    esac
    rm -f "$backup"
    echo "updated"
}

stop_provider() {
    id="$1"
    preserve_autostart="${2:-false}"
    pid_file="$PROVIDER_STATE_DIR/$id/stream.pid"
    if [ -f "$pid_file" ]; then
        pid=$(cat "$pid_file" 2>/dev/null)
        case "$pid" in ''|*[!0-9]*) ;;
            *)
                if tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | \
                    grep -Eq 'provider-runner.sh|vcam-streamer|/system/bin/curl'; then
                    children=$(pgrep -P "$pid" 2>/dev/null)
                    for child in $children; do
                        kill "$child" 2>/dev/null
                    done
                    kill "$pid" 2>/dev/null
                    attempts=0
                    while [ "$attempts" -lt 20 ]; do
                        alive=false
                        kill -0 "$pid" 2>/dev/null && alive=true
                        for child in $children; do
                            kill -0 "$child" 2>/dev/null && alive=true
                        done
                        [ "$alive" = false ] && break
                        usleep 100000
                        attempts=$((attempts + 1))
                    done
                    if kill -0 "$pid" 2>/dev/null && \
                        tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | \
                        grep -Eq 'provider-runner.sh|vcam-streamer|/system/bin/curl'; then
                        kill -9 "$pid" 2>/dev/null
                    fi
                    for child in $children; do
                        if kill -0 "$child" 2>/dev/null && \
                            tr '\000' ' ' < "/proc/$child/cmdline" 2>/dev/null | \
                            grep -Eq 'vcam-streamer|/system/bin/curl'; then
                            kill -9 "$child" 2>/dev/null
                        fi
                    done
                fi
                ;;
        esac
        rm -f "$pid_file"
    fi
    rm -f "$PROVIDER_FRAME_DIR/$id/enabled" "$PROVIDER_FRAME_DIR/$id/frame.rgb.new"
    [ "$preserve_autostart" = true ] || rm -f "$PROVIDER_STATE_DIR/$id/autostart"
}

start_provider() {
    id="$1"
    valid_id "$id" && provider_exists "$id" || {
        echo "provider not found" >&2
        return 2
    }
    case "$id" in physical-0|physical-1) echo "physical provider is always running"; return 0 ;; esac
    meta="$PROVIDER_STATE_DIR/$id/meta"
    type=$(meta_value type "$meta")
    autostart="$PROVIDER_STATE_DIR/$id/autostart"
    case "$type" in
        pattern)
            touch "$autostart"
            chmod 0600 "$autostart"
            touch "$PROVIDER_FRAME_DIR/$id/enabled"
            chown camera:camera "$PROVIDER_FRAME_DIR/$id/enabled"
            chmod 0640 "$PROVIDER_FRAME_DIR/$id/enabled"
            restorecon "$PROVIDER_FRAME_DIR/$id/enabled" >/dev/null 2>&1
            echo "started"
            return 0
            ;;
        image)
            [ -f "$PROVIDER_FRAME_DIR/$id/frame.rgb" ] || {
                echo "image provider has no published frame" >&2
                return 5
            }
            touch "$autostart"
            chmod 0600 "$autostart"
            touch "$PROVIDER_FRAME_DIR/$id/enabled"
            chown camera:camera "$PROVIDER_FRAME_DIR/$id/enabled"
            chmod 0640 "$PROVIDER_FRAME_DIR/$id/enabled"
            restorecon "$PROVIDER_FRAME_DIR/$id/enabled" >/dev/null 2>&1
            echo "started"
            return 0
            ;;
    esac
    touch "$autostart"
    chmod 0600 "$autostart"
    stop_provider "$id" true
    runner=$(find_runner) || { echo "provider runner not found" >&2; return 4; }
    log="$PROVIDER_STATE_DIR/$id/stream.log"
    frame="$PROVIDER_FRAME_DIR/$id/frame.rgb"
    rm -f "$frame"
    touch "$PROVIDER_FRAME_DIR/$id/enabled"
    chown camera:camera "$PROVIDER_FRAME_DIR/$id/enabled"
    chmod 0640 "$PROVIDER_FRAME_DIR/$id/enabled"
    restorecon "$PROVIDER_FRAME_DIR/$id/enabled" >/dev/null 2>&1
    nohup "$runner" "$id" > "$log" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$PROVIDER_STATE_DIR/$id/stream.pid"
    attempts=0
    while [ "$attempts" -lt 15 ]; do
        if [ -s "$frame" ]; then
            echo "started"
            return 0
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 1
        attempts=$((attempts + 1))
    done
    last_error=$(tail -n 1 "$log" 2>/dev/null)
    stop_provider "$id" true
    if [ -n "$last_error" ]; then
        echo "video source did not produce a frame: $last_error" >&2
    else
        echo "video source did not produce a frame within 15 seconds" >&2
    fi
    return 6
}

preview_source() {
    type="$1"
    source_b64="$2"
    case "$type" in rtsp|http|https|hls) ;;
        *) echo "unsupported preview source type" >&2; return 2 ;;
    esac
    valid_base64 "$source_b64" || {
        echo "invalid source encoding" >&2
        return 2
    }
    source=$(printf '%s' "$source_b64" | base64 -d 2>/dev/null) || return 2
    case "$type:$source" in
        rtsp:rtsp://*|http:http://*|https:https://*|hls:http://*) ;;
        *) echo "source URL does not match provider type" >&2; return 2 ;;
    esac

    prepare_dirs || return 3
    streamer=$(find_streamer) || {
        echo "vcam-streamer not found" >&2
        return 4
    }
    publisher=$(find_publisher) || {
        echo "vcam-publisher not found" >&2
        return 4
    }
    preview_dir="$PROVIDER_FRAME_DIR/.preview-$$"
    frame="$preview_dir/frame.rgb"
    cleanup_preview() { rm -rf "$preview_dir"; }
    trap cleanup_preview EXIT HUP INT TERM
    mkdir -p "$preview_dir" || return 3
    chown camera:camera "$preview_dir"
    chmod 0750 "$preview_dir"
    restorecon -RF "$preview_dir" >/dev/null 2>&1
    preview_input="$source"
    if [ "$type" = https ]; then
        preview_input="$preview_dir/source.media"
        /system/bin/runcon u:r:magisk:s0 /system/bin/curl \
            --location --fail --silent --show-error --connect-timeout 10 \
            --max-time 25 --output "$preview_input" "$source" || return 6
        chown camera:camera "$preview_input"
        chmod 0640 "$preview_input"
        restorecon "$preview_input" >/dev/null 2>&1
    fi
    /system/bin/runcon u:r:magisk:s0 "$streamer" \
        "$preview_input" "$frame" 1 576 324 --once || return 6
    [ -s "$frame" ] || {
        echo "preview source produced no frame" >&2
        return 6
    }
    preview_rgb="$preview_dir/preview.rgb"
    "$publisher" --thumbnail "$frame" "$preview_rgb" 576 324 || return 6
    base64 "$preview_rgb" | tr -d '\n'
}

provider_frame() {
    id="$1"
    valid_id "$id" && provider_exists "$id" || { echo "provider not found" >&2; return 2; }
    case "$id" in physical-0|physical-1) echo "physical provider has no virtual frame" >&2; return 3 ;; esac
    frame="$PROVIDER_FRAME_DIR/$id/frame.rgb"
    [ -s "$frame" ] || { echo "provider has no preview frame; start it first" >&2; return 5; }
    publisher=$(find_publisher) || { echo "vcam-publisher not found" >&2; return 4; }
    preview_dir="$PROVIDER_FRAME_DIR/.frame-preview-$$"
    preview="$preview_dir/frame.rgb"
    cleanup_provider_frame() { rm -rf "$preview_dir"; }
    trap cleanup_provider_frame EXIT HUP INT TERM
    mkdir -p "$preview_dir" || return 5
    chown camera:camera "$preview_dir"
    chmod 0750 "$preview_dir"
    restorecon -RF "$preview_dir" >/dev/null 2>&1
    "$publisher" --thumbnail "$frame" "$preview" 640 640 || {
        echo "provider preview thumbnail failed" >&2
        return 5
    }
    [ -s "$preview" ] || { echo "provider preview thumbnail is empty" >&2; return 5; }
    base64 "$preview" | tr -d '\n'
}

remove_provider() {
    id="$1"
    valid_id "$id" || { echo "invalid provider id" >&2; return 2; }
    case "$id" in
        physical-0|physical-1)
            echo "physical providers cannot be removed" >&2
            return 3
            ;;
    esac
    [ -d "$PROVIDER_STATE_DIR/$id" ] || { echo "provider not found" >&2; return 4; }
    stop_provider "$id"
    temporary="$ROUTES_FILE.new"
    awk -F '\t' -v provider_id="$id" 'NF == 3 && $3 != provider_id' \
        "$ROUTES_FILE" > "$temporary"
    mv -f "$temporary" "$ROUTES_FILE"
    chown camera:camera "$ROUTES_FILE"
    chmod 0640 "$ROUTES_FILE"
    restorecon "$ROUTES_FILE" >/dev/null 2>&1
    rm -rf "$PROVIDER_STATE_DIR/$id" "$PROVIDER_FRAME_DIR/$id"
    echo "removed"
}

publish_provider() {
    id="$1"
    frame_base64="$2"
    valid_id "$id" && provider_exists "$id" || {
        echo "provider not found" >&2
        return 2
    }
    case "$id" in physical-0|physical-1) echo "physical provider is read-only" >&2; return 3 ;; esac
    valid_base64 "$frame_base64" || { echo "invalid frame encoding" >&2; return 2; }
    publisher=$(find_publisher) || { echo "vcam-publisher not found" >&2; return 4; }
    output="$PROVIDER_FRAME_DIR/$id/frame.rgb"
    if ! printf '%s' "$frame_base64" | base64 -d | "$publisher" "$output"; then
        echo "frame publish failed" >&2
        return 5
    fi
    touch "$PROVIDER_FRAME_DIR/$id/enabled"
    chown camera:camera "$PROVIDER_FRAME_DIR/$id/frame.rgb" \
        "$PROVIDER_FRAME_DIR/$id/enabled"
    chmod 0640 "$PROVIDER_FRAME_DIR/$id/frame.rgb" \
        "$PROVIDER_FRAME_DIR/$id/enabled"
    restorecon "$PROVIDER_FRAME_DIR/$id/frame.rgb" \
        "$PROVIDER_FRAME_DIR/$id/enabled" >/dev/null 2>&1
    echo "published"
}

publish_provider_stdin() {
    id="$1"
    valid_id "$id" && provider_exists "$id" || {
        echo "provider not found" >&2
        return 2
    }
    case "$id" in physical-0|physical-1) return 3 ;; esac
    publisher=$(find_publisher) || { echo "vcam-publisher not found" >&2; return 4; }
    output="$PROVIDER_FRAME_DIR/$id/frame.rgb"
    if ! "$publisher" "$output"; then
        echo "frame publish failed" >&2
        return 5
    fi
    touch "$PROVIDER_FRAME_DIR/$id/enabled"
    chown camera:camera "$output" "$PROVIDER_FRAME_DIR/$id/enabled"
    chmod 0640 "$output" "$PROVIDER_FRAME_DIR/$id/enabled"
    restorecon "$output" "$PROVIDER_FRAME_DIR/$id/enabled" >/dev/null 2>&1
    echo "published"
}

import_provider_media() {
    id="$1"
    valid_id "$id" && provider_exists "$id" || {
        echo "provider not found" >&2
        return 2
    }
    case "$id" in physical-0|physical-1) return 3 ;; esac
    meta="$PROVIDER_STATE_DIR/$id/meta"
    [ "$(meta_value type "$meta")" = video ] || {
        echo "provider is not a local video" >&2
        return 3
    }
    destination="$PROVIDER_FRAME_DIR/$id/source.media"
    temporary="$destination.new"
    umask 077
    if ! cat > "$temporary"; then
        rm -f "$temporary"
        echo "media import failed" >&2
        return 4
    fi
    [ -s "$temporary" ] || {
        rm -f "$temporary"
        echo "imported media is empty" >&2
        return 5
    }
    mv -f "$temporary" "$destination" || return 4
    chown camera:camera "$destination"
    chmod 0640 "$destination"
    restorecon "$destination" >/dev/null 2>&1
    echo "imported"
}

publish_stage_path() {
    id="$1"
    token="$2"
    printf '%s/%s/publish-%s.b64\n' "$PROVIDER_STATE_DIR" "$id" "$token"
}

publish_begin() {
    id="$1"
    token="$2"
    valid_id "$id" && provider_exists "$id" || {
        echo "provider not found" >&2
        return 2
    }
    case "$id" in physical-0|physical-1) return 3 ;; esac
    valid_id "$token" || { echo "invalid publish token" >&2; return 2; }
    stage="$(publish_stage_path "$id" "$token")"
    : > "$stage" || return 4
    chmod 0600 "$stage"
    echo "ready"
}

publish_chunk() {
    id="$1"
    token="$2"
    chunk="$3"
    valid_id "$id" && valid_id "$token" && valid_base64 "$chunk" || {
        echo "invalid publish chunk" >&2
        return 2
    }
    [ "${#chunk}" -le 49152 ] || {
        echo "publish chunk is too large" >&2
        return 2
    }
    stage="$(publish_stage_path "$id" "$token")"
    [ -f "$stage" ] && [ ! -L "$stage" ] || {
        echo "publish session not found" >&2
        return 3
    }
    current="$(wc -c < "$stage")"
    case "$current" in ''|*[!0-9]*) return 4 ;; esac
    [ "$current" -le 8388608 ] || {
        rm -f "$stage"
        echo "published frame is too large" >&2
        return 5
    }
    printf '%s' "$chunk" >> "$stage" || return 4
    echo "chunk"
}

publish_commit() {
    id="$1"
    token="$2"
    valid_id "$id" && valid_id "$token" && provider_exists "$id" || {
        echo "invalid publish session" >&2
        return 2
    }
    stage="$(publish_stage_path "$id" "$token")"
    [ -s "$stage" ] && [ ! -L "$stage" ] || {
        echo "publish session is empty" >&2
        return 3
    }
    publisher=$(find_publisher) || { echo "vcam-publisher not found" >&2; return 4; }
    output="$PROVIDER_FRAME_DIR/$id/frame.rgb"
    if ! base64 -d "$stage" | "$publisher" "$output"; then
        rm -f "$stage"
        echo "frame publish failed" >&2
        return 5
    fi
    rm -f "$stage"
    touch "$PROVIDER_FRAME_DIR/$id/enabled"
    chown camera:camera "$output" "$PROVIDER_FRAME_DIR/$id/enabled"
    chmod 0640 "$output" "$PROVIDER_FRAME_DIR/$id/enabled"
    restorecon "$output" "$PROVIDER_FRAME_DIR/$id/enabled" >/dev/null 2>&1
    echo "published"
}

publish_abort() {
    valid_id "$1" && valid_id "$2" || return 2
    rm -f "$(publish_stage_path "$1" "$2")"
    echo "aborted"
}

set_route() {
    package="$1"
    target="$2"
    provider="$3"
    valid_package "$package" || { echo "invalid package" >&2; return 2; }
    case "$target" in 0|1) ;; *) echo "invalid target camera" >&2; return 2 ;; esac
    provider_exists "$provider" || { echo "provider not found" >&2; return 3; }
    prepare_dirs || return 4
    temporary="$ROUTES_FILE.new"
    awk -F '\t' -v package="$package" -v target="$target" \
        'NF == 3 && !( $1 == package && $2 == target )' \
        "$ROUTES_FILE" > "$temporary"
    printf '%s\t%s\t%s\n' "$package" "$target" "$provider" >> "$temporary"
    mv -f "$temporary" "$ROUTES_FILE"
    chown camera:camera "$ROUTES_FILE"
    chmod 0640 "$ROUTES_FILE"
    restorecon "$ROUTES_FILE" >/dev/null 2>&1
    echo "routed"
}

save_routes() {
    package="$1"
    provider0="$2"
    provider1="$3"
    valid_package "$package" || { echo "invalid package" >&2; return 2; }
    for provider in "$provider0" "$provider1"; do
        [ -z "$provider" ] || provider_exists "$provider" || {
            echo "provider not found" >&2
            return 3
        }
    done
    prepare_dirs || return 4
    temporary="$ROUTES_FILE.new-$$"
    awk -F '\t' -v package_name="$package" \
        'NF == 3 && $1 != package_name' "$ROUTES_FILE" > "$temporary" || return 4
    [ -z "$provider0" ] || printf '%s\t0\t%s\n' "$package" "$provider0" >> "$temporary"
    [ -z "$provider1" ] || printf '%s\t1\t%s\n' "$package" "$provider1" >> "$temporary"
    mv -f "$temporary" "$ROUTES_FILE" || return 4
    chown camera:camera "$ROUTES_FILE"
    chmod 0640 "$ROUTES_FILE"
    restorecon "$ROUTES_FILE" >/dev/null 2>&1
    echo "saved"
}

remove_route() {
    package="$1"
    target="$2"
    valid_package "$package" || return 2
    case "$target" in 0|1) ;; *) return 2 ;; esac
    prepare_dirs || return 3
    temporary="$ROUTES_FILE.new"
    awk -F '\t' -v package="$package" -v target="$target" \
        'NF == 3 && !( $1 == package && $2 == target )' \
        "$ROUTES_FILE" > "$temporary"
    mv -f "$temporary" "$ROUTES_FILE"
    chown camera:camera "$ROUTES_FILE"
    chmod 0640 "$ROUTES_FILE"
    restorecon "$ROUTES_FILE" >/dev/null 2>&1
    echo "unrouted"
}

list_routes() {
    prepare_dirs || return 1
    while IFS="$(printf '\t')" read -r package target provider; do
        [ -n "$package" ] && [ -n "$target" ] && [ -n "$provider" ] || continue
        printf 'ROUTE\t%s\t%s\t%s\n' "$package" "$target" "$provider"
    done < "$ROUTES_FILE"
}

print_status() {
    [ -e "$MODDIR/disable" ] && echo "module_enabled=false" || echo "module_enabled=true"
    [ -e "$STATE_DIR/mount.ok" ] && echo "mount_active=true" || echo "mount_active=false"
    camera_devices=$(dumpsys media.camera 2>/dev/null | \
        sed -n 's/.*Number of camera devices: //p' | head -n 1)
    [ -n "$camera_devices" ] || camera_devices=unavailable
    echo "camera_devices=$camera_devices"
    provider_count=$(list_providers | wc -l)
    route_count=$(list_routes | wc -l)
    echo "provider_count=$provider_count"
    echo "route_count=$route_count"
    if [ -r /vendor/lib64/hw/camera.qcom.so ]; then
        echo "hal_hash=$(sha256sum /vendor/lib64/hw/camera.qcom.so | awk '{print $1}')"
    fi
}

print_capabilities() {
    if [ ! -r "$PROFILE_FILE" ] && [ -x "$MODDIR/device-probe.sh" ]; then
        "$MODDIR/device-probe.sh" "$PROFILE_FILE" >/dev/null 2>&1 || true
    fi
    [ -r "$PROFILE_FILE" ] || {
        echo "device capability profile unavailable" >&2
        return 1
    }
    cat "$PROFILE_FILE"
}

case "$1" in
    status) print_status ;;
    capabilities) print_capabilities ;;
    providers) list_providers ;;
    provider-add) add_provider "$2" "$3" "$4" "$5" ;;
    provider-remove) remove_provider "$2" ;;
    provider-start) start_provider "$2" ;;
    provider-stop) stop_provider "$2"; echo "stopped" ;;
    source-preview) preview_source "$2" "$3" ;;
    provider-frame) provider_frame "$2" ;;
    provider-update) provider_update "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" ;;
    provider-publish) publish_provider "$2" "$3" ;;
    provider-publish-stdin) publish_provider_stdin "$2" ;;
    provider-import-media) import_provider_media "$2" ;;
    provider-config) provider_config "$2" ;;
    provider-config-set) provider_config_set "$2" "$3" "$4" "$5" "$6" "$7" ;;
    provider-publish-begin) publish_begin "$2" "$3" ;;
    provider-publish-chunk) publish_chunk "$2" "$3" "$4" ;;
    provider-publish-commit) publish_commit "$2" "$3" ;;
    provider-publish-abort) publish_abort "$2" "$3" ;;
    routes) list_routes ;;
    route-set) set_route "$2" "$3" "$4" ;;
    route-remove) remove_route "$2" "$3" ;;
    route-save) save_routes "$2" "$3" "$4" ;;
    apps) pm list packages 2>/dev/null | sed 's/^package://' | sort ;;
    *)
        echo "usage: vcamctl {status|capabilities|providers|provider-add|provider-remove|provider-start|provider-stop|source-preview|provider-frame|provider-update|provider-config|provider-config-set|provider-publish|provider-publish-stdin|provider-import-media|provider-publish-begin|provider-publish-chunk|provider-publish-commit|provider-publish-abort|routes|route-set|route-remove|route-save|apps}" >&2
        exit 64
        ;;
esac
